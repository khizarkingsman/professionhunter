rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Workers can only update their own locations. Clients can only read.
    match /workerLocations/{userId} {
      // Anyone can read (so Seekers can get the data)
      allow read: if request.auth != null;
      
      // Only the worker themselves can update their own location document
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default catch-all (adjust for other collections)
    match /{document=**} {
      allow read, write: if request.auth != null; 
    }
  }
}
