rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin';
    }

    function isStoreOwner() {
      return isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ── Collection: users ─────────────────────────────────────────────────
    match /users/{userId} {
      // 1. Read: Public read permitted for viewing worker & seeker profiles
      allow read: if true;

      // 2. Create (Signup): User can only create their own matching Auth UID document
      allow create: if isOwner(userId)
        && request.resource.data.role in ['worker', 'seeker', 'store']
        && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
        && (!('iqamaStatus' in request.resource.data) || request.resource.data.iqamaStatus == 'none' || request.resource.data.iqamaStatus == 'pending');

      // 3. Update: Owner can update non-privileged profile fields; Admin can update all fields
      allow update: if isAdmin() || (
        isOwner(userId)
        // Block normal users from elevating role or self-approving verifications
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'isVerified',
          'iqamaStatus',
          'iqamaVerifiedAt',
          'subscriptionGrantedBy'
        ]))
      );

      // 4. Delete: Restricted to Account Owner or Admin
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Collection: workerLocations ───────────────────────────────────────
    match /workerLocations/{workerId} {
      // 1. Read: Public read permitted so seekers can find active workers on map
      allow read: if true;

      // 2. Write (Create & Update): Restricted strictly to the worker who owns the record
      allow create, update: if isOwner(workerId);

      // 3. Delete: Restricted to worker owner or Admin
      allow delete: if isOwner(workerId) || isAdmin();
    }

    // ── Collection: stores ────────────────────────────────────────────────
    match /stores/{storeId} {
      // 1. Read: Public read permitted so customers can view store listings
      allow read: if true;

      // 2. Create: Authenticated users registering a store (must set ownerId == request.auth.uid & status == pending)
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && (!('status' in request.resource.data) || request.resource.data.status == 'pending');

      // 3. Update: Store Owner (matching ownerId) or Admin
      allow update: if isAdmin() || (
        isStoreOwner()
        // Prevent store owners from self-approving store status or changing ownerId
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'ownerId']))
      );

      // 4. Delete: Store Owner or Admin
      allow delete: if isStoreOwner() || isAdmin();
    }

    // ── Default Fallback ──────────────────────────────────────────────────
    // Deny access to any unmentioned collections/documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
