# .env.local.example
#
# Copy this file to .env.local and fill in real values.
# This example file is safe to commit — it contains NO real secrets.
# .env.local is listed in .gitignore and must NEVER be committed.

# ── Firebase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── EmailJS (OTP password reset) ──────────────────────────────────────────────
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# ── Server Secrets (SERVER ONLY - NEVER EXPOSE AS NEXT_PUBLIC) ─────────────
# REQUIRED — must be set before starting the server
JWT_SECRET=generate_a_random_64_character_hex_or_base64_secret_here
ADMIN_PASSWORD=change_me_to_a_strong_password

# Firebase Admin SDK (SERVER ONLY - never prefix with NEXT_PUBLIC_)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON content as a single line (minify it, no newlines)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# ── Rate limiting thresholds (all have safe defaults — uncomment to override) ──
# NEXT_PUBLIC_RATE_LIMIT_AUTH_MAX=5
# NEXT_PUBLIC_RATE_LIMIT_AUTH_WINDOW_MS=900000
# NEXT_PUBLIC_RATE_LIMIT_AUTH_BASE_DELAY_MS=30000
# NEXT_PUBLIC_RATE_LIMIT_AUTH_MAX_DELAY_MS=3600000
# NEXT_PUBLIC_RATE_LIMIT_PUBLIC_MAX=30
# NEXT_PUBLIC_RATE_LIMIT_PUBLIC_WINDOW_MS=60000
# NEXT_PUBLIC_RATE_LIMIT_AUTHED_MAX=60
# NEXT_PUBLIC_RATE_LIMIT_AUTHED_WINDOW_MS=60000

# ── WhatsApp Cloud API (Phone OTP Verification) ──────────────────────────────
# SERVER ONLY - NEVER EXPOSE AS NEXT_PUBLIC
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# Optional overrides (default template name and language)
# WHATSAPP_TEMPLATE_NAME=phone_verification
# WHATSAPP_TEMPLATE_LANG=en_US

